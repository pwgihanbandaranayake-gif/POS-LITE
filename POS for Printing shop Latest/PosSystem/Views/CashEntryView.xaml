<UserControl x:Class="PosSystem.Views.CashEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:PosSystem.Helpers">
    <Border Style="{StaticResource Panel}" Width="560" HorizontalAlignment="Left" VerticalAlignment="Top">
        <StackPanel>
            <TextBlock Text="{Binding Title, Converter={StaticResource Tr}}" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="{s:Tr 'Amount'}" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource DisplayFont}" FontSize="28" s:FocusOnLoad.Enabled="True"/>

            <!-- paid out -->
            <StackPanel Visibility="{Binding IsPaidOut, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{s:Tr 'Category'}" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" IsEditable="True" Text="{Binding Category}"/>
                <TextBlock Text="{s:Tr 'Paid to employee (optional)'}" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding Employees}" SelectedItem="{Binding Employee}" DisplayMemberPath="Name"/>
            </StackPanel>

            <!-- receive -->
            <StackPanel Visibility="{Binding IsReceive, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{s:Tr 'Customer (credit settlement)'}" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding CustomerSearch, UpdateSourceTrigger=PropertyChanged, Delay=300}" ToolTip="{s:Tr 'Search name / mobile'}"/>
                <ListBox ItemsSource="{Binding Customers}" SelectedItem="{Binding Customer}" Height="130" Margin="0,4,0,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Width="480">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Outstanding, StringFormat=Owes {0:N2}}" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock><Run Text="{Binding Name, Mode=OneWay}"/>  <Run Text="{Binding Mobile, Mode=OneWay}" Foreground="{StaticResource MutedBrush}"/></TextBlock>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="{s:Tr 'Received by'}" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding Methods}" SelectedItem="{Binding Method}" DisplayMemberPath="Name"/>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{s:Tr 'Cheque / ref no'}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding ChequeNo}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{s:Tr 'Bank'}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Bank}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <TextBlock Text="{s:Tr 'Description'}" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="{s:Tr 'Close'}" Command="{Binding CancelCommand}" Margin="0,0,8,0" MinWidth="90"/>
                <Button Content="{s:Tr 'Save and print slip'}" Command="{Binding SaveCommand}" Style="{StaticResource BtnPrimary}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
