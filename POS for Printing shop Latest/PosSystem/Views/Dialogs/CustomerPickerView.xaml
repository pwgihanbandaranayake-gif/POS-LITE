<UserControl x:Class="PosSystem.Views.Dialogs.CustomerPickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:PosSystem.Helpers" Width="820" Height="560">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{s:Tr 'Customer'}" Style="{StaticResource SectionTitle}"/>
        <TextBox DockPanel.Dock="Top" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}" FontSize="17" s:FocusOnLoad.Enabled="True">
            <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding ChooseCommand}"/></TextBox.InputBindings>
        </TextBox>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Panel}" Padding="12" Margin="0,12,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{s:Tr 'Add and select'}" Command="{Binding QuickAddCommand}" Margin="8,0,0,0"/>
                <TextBlock DockPanel.Dock="Left" Text="{s:Tr 'New customer'}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                    <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" ToolTip="{s:Tr 'Name'}" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1" Text="{Binding NewMobile, UpdateSourceTrigger=PropertyChanged}" ToolTip="{s:Tr 'Mobile'}"/>
                </Grid>
            </DockPanel>
        </Border>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{s:Tr 'Walk-in (no customer)'}" Command="{Binding ClearCustomerCommand}" Margin="0,0,8,0"/>
            <Button Content="{s:Tr 'Cancel'}" Command="{Binding CancelCommand}" MinWidth="100" Margin="0,0,8,0"/>
            <Button Content="{s:Tr 'Select'}" Command="{Binding ChooseCommand}" Style="{StaticResource BtnPrimary}" MinWidth="110"/>
        </StackPanel>
        <DataGrid ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}" Margin="0,10,0,0" MouseDoubleClick="Pick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{s:Tr 'Name'}" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="{s:Tr 'Mobile'}" Binding="{Binding Mobile}" Width="130"/>
                <DataGridTextColumn Header="{s:Tr 'Code'}" Binding="{Binding Code}" Width="90"/>
                <DataGridTextColumn Header="{s:Tr 'Outstanding'}" Binding="{Binding Outstanding, StringFormat={}{0:N2}}" Width="120" ElementStyle="{StaticResource RightCell}"/>
                <DataGridTextColumn Header="{s:Tr 'Credit limit'}" Binding="{Binding CreditLimit, StringFormat={}{0:N2}}" Width="110" ElementStyle="{StaticResource RightCell}"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
