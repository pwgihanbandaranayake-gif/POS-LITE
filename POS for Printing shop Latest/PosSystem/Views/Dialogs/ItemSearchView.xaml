<UserControl x:Class="PosSystem.Views.Dialogs.ItemSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:PosSystem.Helpers" Width="900" Height="560">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{s:Tr 'Find item'}" Style="{StaticResource SectionTitle}"/>
        <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" FontSize="18"
                 s:FocusOnLoad.Enabled="True" PreviewKeyDown="SearchKeyDown"/>
        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="0,8,0,0" Text="{s:Tr 'Type part of the name, code or barcode. Up/Down to move, Enter to add, Esc to close.'}"/>
        <DataGrid x:Name="Grid" ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}" Margin="0,10,0,0" MouseDoubleClick="GridDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{s:Tr 'Code'}" Binding="{Binding ItemCode}" Width="110"/>
                <DataGridTextColumn Header="{s:Tr 'Barcode'}" Binding="{Binding BarCode}" Width="140"/>
                <DataGridTextColumn Header="{s:Tr 'Item'}" Binding="{Binding DisplayName}" Width="*"/>
                <DataGridTextColumn Header="{s:Tr 'Category'}" Binding="{Binding CategoryName}" Width="140"/>
                <DataGridTextColumn Header="{s:Tr 'Price'}" Binding="{Binding SellingPrice, StringFormat={}{0:N2}}" Width="100" ElementStyle="{StaticResource RightCell}"/>
                <DataGridTextColumn Header="{s:Tr 'Stock'}" Binding="{Binding StockOnHand, StringFormat={}{0:0.###}}" Width="80" ElementStyle="{StaticResource RightCell}"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
