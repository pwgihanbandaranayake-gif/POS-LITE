<UserControl x:Class="PosSystem.Views.Dialogs.ManagerOverrideView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:PosSystem.Helpers" Width="420">
    <StackPanel>
        <TextBlock Text="{s:Tr 'Supervisor approval needed'}" Style="{StaticResource SectionTitle}"/>
        <Border Background="{StaticResource TagSoftBrush}" CornerRadius="4" Padding="10,8">
            <TextBlock Text="{Binding Action, Converter={StaticResource Tr}}" TextWrapping="Wrap" FontWeight="SemiBold"/>
        </Border>
        <TextBlock Text="{s:Tr 'Supervisor user name (or scan ID card)'}" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" s:FocusOnLoad.Enabled="True"/>
        <TextBlock Text="{s:Tr 'Password'}" Style="{StaticResource FieldLabel}"/>
        <PasswordBox s:PasswordTarget.Property="Password">
            <PasswordBox.InputBindings><KeyBinding Key="Enter" Command="{Binding ApproveCommand}"/></PasswordBox.InputBindings>
        </PasswordBox>
        <TextBlock Text="{Binding Error, Converter={StaticResource Tr}}" Foreground="{StaticResource AlertBrush}" TextWrapping="Wrap" Margin="0,10,0,0"
                   Visibility="{Binding Error, Converter={StaticResource NullToVis}}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="{s:Tr 'Cancel'}" Command="{Binding CancelCommand}" MinWidth="100" Margin="0,0,8,0"/>
            <Button Content="{s:Tr 'Approve'}" Command="{Binding ApproveCommand}" Style="{StaticResource BtnPrimary}" MinWidth="110"/>
        </StackPanel>
    </StackPanel>
</UserControl>
