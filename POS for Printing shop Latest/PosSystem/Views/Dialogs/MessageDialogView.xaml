<UserControl x:Class="PosSystem.Views.Dialogs.MessageDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:PosSystem.Helpers" MaxWidth="560">
    <StackPanel>
        <DockPanel>
            <Border Width="44" Height="44" CornerRadius="22" Margin="0,0,16,0" VerticalAlignment="Top">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource LeafSoftBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True"><Setter Property="Background" Value="{StaticResource AlertSoftBrush}"/></DataTrigger>
                            <DataTrigger Binding="{Binding IsConfirm}" Value="True"><Setter Property="Background" Value="{StaticResource TagSoftBrush}"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock HorizontalAlignment="Center" FontSize="20">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                            <Setter Property="Text" Value="&#xE946;"/>
                            <Setter Property="Foreground" Value="{StaticResource LeafBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True"><Setter Property="Text" Value="&#xE7BA;"/><Setter Property="Foreground" Value="{StaticResource AlertBrush}"/></DataTrigger>
                                <DataTrigger Binding="{Binding IsConfirm}" Value="True"><Setter Property="Text" Value="&#xE9CE;"/><Setter Property="Foreground" Value="#9A6B00"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
            <StackPanel>
                <TextBlock Text="{Binding Title, Converter={StaticResource Tr}}" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                <TextBlock Text="{Binding Message, Converter={StaticResource Tr}}" TextWrapping="Wrap" FontSize="15" LineHeight="22"/>
            </StackPanel>
        </DockPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="{s:Tr 'No'}" Command="{Binding CancelCommand}" MinWidth="100" Margin="0,0,8,0" Visibility="{Binding IsConfirm, Converter={StaticResource BoolToVis}}"/>
            <Button Content="{Binding OkText, Converter={StaticResource Tr}}" Command="{Binding OkCommand}" Style="{StaticResource BtnPrimary}" MinWidth="110" IsDefault="True" s:FocusOnLoad.Enabled="True"/>
        </StackPanel>
    </StackPanel>
</UserControl>
