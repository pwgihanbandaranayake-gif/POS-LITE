<UserControl x:Class="PosSystem.Views.Dialogs.OpenSessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:PosSystem.Helpers" Width="420">
    <StackPanel>
        <TextBlock Text="{s:Tr 'Start your shift'}" Style="{StaticResource SectionTitle}"/>
        <TextBlock Style="{StaticResource Hint}" Text="{s:Tr 'Count the cash float in the drawer before the first bill. It is used to check the cash at shift close.'}"/>
        <TextBlock Text="{s:Tr 'Opening cash float'}" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding OpeningFloat, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource DisplayFont}" FontSize="26" s:FocusOnLoad.Enabled="True">
            <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding StartCommand}"/></TextBox.InputBindings>
        </TextBox>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="{s:Tr 'Cancel'}" Command="{Binding CancelCommand}" MinWidth="100" Margin="0,0,8,0"/>
            <Button Content="{s:Tr 'Start shift'}" Command="{Binding StartCommand}" Style="{StaticResource BtnPrimary}" MinWidth="120"/>
        </StackPanel>
    </StackPanel>
</UserControl>
