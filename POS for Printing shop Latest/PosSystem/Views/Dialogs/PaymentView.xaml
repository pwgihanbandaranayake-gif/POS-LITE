<UserControl x:Class="PosSystem.Views.Dialogs.PaymentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:PosSystem.Helpers" Width="960" PreviewKeyDown="OnKey">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="370"/>
        </Grid.ColumnDefinitions>

        <!-- left: methods, amount, tenders -->
        <StackPanel Margin="0,0,20,0">
            <TextBlock Text="{s:Tr 'Payment'}" Style="{StaticResource SectionTitle}"/>
            <ItemsControl ItemsSource="{Binding Methods}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Tag="{Binding ShortcutKey}" Content="{Binding Name, Converter={StaticResource Tr}}" Style="{StaticResource FKey}"
                                Command="{Binding DataContext.SelectMethodCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,4">
                <Run Text="{s:Tr 'Amount for'}"/> <Run Text="{Binding SelectedMethod.Name, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource LeafBrush}"/>  <Run Text="{s:Tr '(Enter to add)'}"/>
            </TextBlock>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{s:Tr 'Exact'}" Command="{Binding ExactCommand}" Margin="8,0,0,0" MinWidth="90" Focusable="False"/>
                <TextBox x:Name="AmountBox" Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource DisplayFont}" FontSize="30"
                         s:FocusOnLoad.Enabled="True" HorizontalContentAlignment="Right">
                    <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding AddTenderCommand}"/></TextBox.InputBindings>
                </TextBox>
            </DockPanel>
            <ItemsControl ItemsSource="{Binding QuickCash}" Margin="-3,6,-3,0">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding}" ContentStringFormat="N0" Margin="3" Focusable="False" FontFamily="{StaticResource DisplayFont}" FontSize="17"
                                Command="{Binding DataContext.QuickAmountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{s:Tr 'Payments on this bill'}" Style="{StaticResource FieldLabel}" Margin="0,16,0,4"/>
            <DataGrid ItemsSource="{Binding Tenders}" SelectedItem="{Binding SelectedTender}" Height="150" Focusable="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{s:Tr 'Method'}" Binding="{Binding Display}" Width="*"/>
                    <DataGridTextColumn Header="{s:Tr 'Amount'}" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="130" ElementStyle="{StaticResource RightCell}"/>
                </DataGrid.Columns>
            </DataGrid>
            <Button Content="{s:Tr 'Remove selected payment'}" Command="{Binding RemoveTenderCommand}" Style="{StaticResource BtnGhost}" Foreground="{StaticResource AlertBrush}"
                    HorizontalAlignment="Left" Focusable="False"/>
        </StackPanel>

        <!-- right: amounts + print + complete -->
        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" Background="{StaticResource VfdBgBrush}" CornerRadius="6" Padding="18,14">
                <StackPanel TextBlock.Foreground="#7FB8AE" TextBlock.FontSize="14">
                    <TextBlock Text="{s:Tr 'Bill total'}"/>
                    <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="40" Foreground="{StaticResource VfdTextBrush}" HorizontalAlignment="Right">
                        <Run Text="{Binding Currency, Mode=OneWay}" FontSize="18"/> <Run Text="{Binding Due, StringFormat={}{0:N2}, Mode=OneWay}"/>
                    </TextBlock>
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Paid, StringFormat={}{0:N2}}" Foreground="White" FontSize="18"/>
                        <TextBlock Text="{s:Tr 'Paid'}"/>
                    </DockPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Balance, StringFormat={}{0:N2}}" Foreground="{StaticResource TagBrush}" FontSize="18"/>
                        <TextBlock Text="{s:Tr 'Balance to pay'}"/>
                    </DockPanel>
                    <Border BorderBrush="#1F5C61" BorderThickness="0,1,0,0" Margin="0,10,0,6"/>
                    <TextBlock Text="{s:Tr 'Change to give'}"/>
                    <TextBlock Text="{Binding Change, StringFormat={}{0:N2}}" FontFamily="{StaticResource DisplayFont}" FontSize="44"
                               Foreground="{StaticResource VfdTextBrush}" HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>

            <StackPanel DockPanel.Dock="Top" Margin="0,14,0,0">
                <TextBlock Text="{s:Tr 'Print'}" Style="{StaticResource FieldLabel}"/>
                <WrapPanel>
                    <RadioButton Content="{s:Tr 'Receipt'}" IsChecked="{Binding PrintMode, Converter={StaticResource EqBool}, ConverterParameter=1}" Focusable="False"/>
                    <RadioButton Content="{s:Tr 'A5 half sheet'}" IsChecked="{Binding PrintMode, Converter={StaticResource EqBool}, ConverterParameter=3}" Focusable="False"/>
                    <RadioButton Content="{s:Tr 'No print'}" IsChecked="{Binding PrintMode, Converter={StaticResource EqBool}, ConverterParameter=0}" Focusable="False"/>
                </WrapPanel>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom">
                <Button Command="{Binding CompleteCommand}" Style="{StaticResource BtnPrimary}" MinHeight="64" Focusable="False" IsEnabled="{Binding IsSettled}">
                    <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="22"><Run Text="{s:Tr 'Complete sale'}"/>   <Run Text="F10" FontSize="14"/></TextBlock>
                </Button>
                <Button Content="{s:Tr 'Back to bill (Esc)'}" Command="{Binding CancelCommand}" Margin="0,8,0,0" Focusable="False"/>
            </StackPanel>
            <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Bottom" Margin="0,0,0,10"
                       Text="{s:Tr 'F1 to F8 choose the payment method. Split a bill by adding several payments, e.g. part card and part cash.'}"/>
        </DockPanel>
    </Grid>
</UserControl>
