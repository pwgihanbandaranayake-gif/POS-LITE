<UserControl x:Class="PosSystem.Views.Dialogs.PricePickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:PosSystem.Helpers" Width="480">
    <StackPanel>
        <TextBlock Text="{s:Tr 'This item has more than one price in stock'}" Style="{StaticResource SectionTitle}"/>
        <TextBlock Text="{Binding ItemName}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <ListBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" HorizontalContentAlignment="Stretch" s:FocusOnLoad.Enabled="True"
                 MouseDoubleClick="Pick" MaxHeight="360">
            <ListBox.InputBindings><KeyBinding Key="Enter" Command="{Binding ChooseCommand}"/></ListBox.InputBindings>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="6,8">
                        <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center">
                            <Run Text="{s:Tr 'In stock'}"/> <Run Text="{Binding Qty, StringFormat={}{0:0.###}, Mode=OneWay}"/>   <Run Text="{s:Tr 'Exp'}"/> <Run Text="{Binding ExpiryText, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding Price, StringFormat={}{0:N2}}" FontFamily="{StaticResource DisplayFont}" FontSize="24"/>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{s:Tr 'Cancel'}" Command="{Binding CancelCommand}" MinWidth="100" Margin="0,0,8,0"/>
            <Button Content="{s:Tr 'Use this price'}" Command="{Binding ChooseCommand}" Style="{StaticResource BtnPrimary}"/>
        </StackPanel>
    </StackPanel>
</UserControl>
