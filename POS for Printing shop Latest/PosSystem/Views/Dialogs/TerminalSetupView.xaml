<UserControl x:Class="PosSystem.Views.Dialogs.TerminalSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:PosSystem.Helpers" Width="460">
    <StackPanel>
        <TextBlock Text="{s:Tr 'Register this computer as a till'}" Style="{StaticResource SectionTitle}"/>
        <TextBlock Style="{StaticResource Hint}">
            <Run Text="{s:Tr 'Computer name'}"/> <Run Text="{Binding MachineCode, Mode=OneWay}" FontWeight="SemiBold"/>. <Run Text="{s:Tr 'Printer settings can be changed later in Settings.'}"/>
        </TextBlock>
        <TextBlock Text="{s:Tr 'Counter name (printed on bills)'}" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" s:FocusOnLoad.Enabled="True"/>
        <TextBlock Text="{s:Tr 'Location / branch this till sells from'}" Style="{StaticResource FieldLabel}"/>
        <ComboBox ItemsSource="{Binding Locations}" SelectedItem="{Binding SelectedLocation}" DisplayMemberPath="LocationName"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="{s:Tr 'Cancel'}" Command="{Binding CancelCommand}" MinWidth="100" Margin="0,0,8,0"/>
            <Button Content="{s:Tr 'Register'}" Command="{Binding SaveCommand}" Style="{StaticResource BtnPrimary}" MinWidth="110" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</UserControl>
