<UserControl x:Class="PosSystem.Views.InvoicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:PosSystem.Helpers">
    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource Panel}" Padding="14,8,14,12">
            <WrapPanel VerticalAlignment="Bottom">
                <StackPanel Width="150" Margin="0,0,10,0"><TextBlock Text="{s:Tr 'From'}" Style="{StaticResource FieldLabel}"/><DatePicker SelectedDate="{Binding FromDate}"/></StackPanel>
                <StackPanel Width="150" Margin="0,0,10,0"><TextBlock Text="{s:Tr 'To'}" Style="{StaticResource FieldLabel}"/><DatePicker SelectedDate="{Binding ToDate}"/></StackPanel>
                <StackPanel Width="260" Margin="0,0,10,0">
                    <TextBlock Text="{s:Tr 'Bill no or customer'}" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding FindCommand}"/></TextBox.InputBindings>
                    </TextBox>
                </StackPanel>
                <CheckBox Content="{s:Tr 'All locations'}" IsChecked="{Binding AllLocations}" VerticalAlignment="Bottom" Margin="0,0,12,8"/>
                <Button Content="{s:Tr 'Find'}" Command="{Binding FindCommand}" Style="{StaticResource BtnPrimary}" VerticalAlignment="Bottom" MinWidth="90"/>
            </WrapPanel>
        </Border>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="15">
                <Run Text="{s:Tr 'Total (excluding cancelled)'}"/> <Run Text="{Binding Total, StringFormat={}{0:N2}, Mode=OneWay}" FontWeight="Bold"/>
            </TextBlock>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{s:Tr 'Cancel invoice'}" Command="{Binding CancelInvoiceCommand}" Style="{StaticResource BtnGhost}" Foreground="{StaticResource AlertBrush}" Margin="0,0,8,0"/>
                <Button Content="{s:Tr 'Preview'}" Command="{Binding PreviewCommand}" Margin="0,0,8,0"/>
                <Button Content="{s:Tr 'Print A5 half sheet'}" Command="{Binding ReprintCommand}" CommandParameter="3" Margin="0,0,8,0"/>
                <Button Content="{s:Tr 'Re-print receipt'}" Command="{Binding ReprintCommand}" CommandParameter="1" Style="{StaticResource BtnPrimary}"/>
            </StackPanel>
        </DockPanel>
        <DataGrid ItemsSource="{Binding Invoices}" SelectedItem="{Binding Selected}" Margin="0,12,0,0">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCanceled}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource AlertBrush}"/>
                            <Setter Property="FontStyle" Value="Italic"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="{s:Tr 'Invoice no'}" Binding="{Binding InvoiceNo}" Width="170"/>
                <DataGridTextColumn Header="{s:Tr 'Date time'}" Binding="{Binding TransactionDate, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="140"/>
                <DataGridTextColumn Header="{s:Tr 'Cashier'}" Binding="{Binding Cashier}" Width="160"/>
                <DataGridTextColumn Header="{s:Tr 'Customer'}" Binding="{Binding Customer}" Width="*"/>
                <DataGridTextColumn Header="{s:Tr 'Payment'}" Binding="{Binding Payments}" Width="170"/>
                <DataGridTextColumn Header="{s:Tr 'Total'}" Binding="{Binding NetTotal, StringFormat={}{0:N2}}" Width="110" ElementStyle="{StaticResource RightCell}"/>
                <DataGridCheckBoxColumn Header="{s:Tr 'Cancelled'}" Binding="{Binding IsCanceled}" Width="85"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
