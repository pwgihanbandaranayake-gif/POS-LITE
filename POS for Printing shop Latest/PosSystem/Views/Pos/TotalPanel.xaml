<UserControl x:Class="PosSystem.Views.Pos.TotalPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:PosSystem.Helpers">
    <!-- Styled after a VFD customer pole display: the one bold element of the till -->
    <Border Background="{StaticResource VfdBgBrush}" CornerRadius="6" Padding="18,14">
        <StackPanel>
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Foreground="#7FB8AE" FontSize="13">
                    <Run Text="{Binding ItemCount, Mode=OneWay}"/> <Run Text="{s:Tr 'lines  /  qty'}"/> <Run Text="{Binding TotalQty, StringFormat={}{0:0.###}, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Text="{s:Tr 'Total to pay'}" Foreground="#7FB8AE" FontSize="13"/>
            </DockPanel>
            <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Right" Margin="0,4,0,0">
                <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="54" Foreground="{StaticResource VfdTextBrush}">
                    <Run Text="{Binding Currency, Mode=OneWay}" FontSize="24"/> <Run Text="{Binding NetTotal, StringFormat={}{0:N2}, Mode=OneWay}"/>
                    <TextBlock.Effect><DropShadowEffect Color="#5FF5D1" BlurRadius="14" ShadowDepth="0" Opacity="0.55"/></TextBlock.Effect>
                </TextBlock>
            </Viewbox>
            <Border Background="#0B3B40" CornerRadius="3" Padding="10,6" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding LastItemName, Converter={StaticResource Tr}}" Foreground="{StaticResource VfdTextBrush}" FontFamily="{StaticResource DisplayFont}"
                               FontSize="17" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding LastItemInfo, Converter={StaticResource Tr}}" Foreground="#7FB8AE" FontSize="13"/>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource TagBrush}" CornerRadius="3" Padding="10,4" Margin="0,8,0,0" HorizontalAlignment="Left"
                    Visibility="{Binding Savings, Converter={StaticResource NonZeroToVis}}">
                <TextBlock FontWeight="SemiBold" Foreground="{StaticResource InkBrush}">
                    <Run Text="{s:Tr 'Customer saves'}"/> <Run Text="{Binding Savings, StringFormat={}{0:N2}, Mode=OneWay}"/>
                </TextBlock>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
