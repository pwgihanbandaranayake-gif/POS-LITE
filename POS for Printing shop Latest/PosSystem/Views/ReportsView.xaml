<UserControl x:Class="PosSystem.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:PosSystem.Helpers">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <!-- catalogue -->
        <Border Style="{StaticResource Panel}" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="{Binding Name, Converter={StaticResource Tr}}" FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource LeafBrush}" Margin="8,6,0,4"/>
                                <ItemsControl ItemsSource="{Binding Reports}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <RadioButton GroupName="rpt" Cursor="Hand" Margin="0"
                                                         Command="{Binding DataContext.SelectReportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                         CommandParameter="{Binding}">
                                                <RadioButton.Template>
                                                    <ControlTemplate TargetType="RadioButton">
                                                        <Border x:Name="bd" Padding="10,6" CornerRadius="4" Background="Transparent">
                                                            <TextBlock Text="{Binding Title, Converter={StaticResource Tr}}" FontSize="13.5"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource ShelfBrush}"/></Trigger>
                                                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource LeafSoftBrush}"/></Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </RadioButton.Template>
                                            </RadioButton>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- filters + result -->
        <DockPanel Grid.Column="2">
            <Border DockPanel.Dock="Top" Style="{StaticResource Panel}" Padding="14,8,14,12" Visibility="{Binding HasReport, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedReport.Title, Converter={StaticResource Tr}}" Style="{StaticResource SectionTitle}" Margin="0,4,0,0"/>
                    <WrapPanel VerticalAlignment="Bottom">
                        <StackPanel Orientation="Horizontal" Visibility="{Binding ShowDates, Converter={StaticResource BoolToVis}}">
                            <StackPanel Width="140" Margin="0,0,8,0"><TextBlock Text="{s:Tr 'From'}" Style="{StaticResource FieldLabel}"/><DatePicker SelectedDate="{Binding FromDate}"/></StackPanel>
                            <StackPanel Width="140" Margin="0,0,8,0"><TextBlock Text="{s:Tr 'To'}" Style="{StaticResource FieldLabel}"/><DatePicker SelectedDate="{Binding ToDate}"/></StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{s:Tr 'Quick'}" Style="{StaticResource FieldLabel}"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{s:Tr 'Today'}" Command="{Binding QuickRangeCommand}" CommandParameter="today" Padding="8,4" Margin="0,0,4,0"/>
                                    <Button Content="{s:Tr 'Yesterday'}" Command="{Binding QuickRangeCommand}" CommandParameter="yesterday" Padding="8,4" Margin="0,0,4,0"/>
                                    <Button Content="{s:Tr 'This week'}" Command="{Binding QuickRangeCommand}" CommandParameter="week" Padding="8,4" Margin="0,0,4,0"/>
                                    <Button Content="{s:Tr 'This month'}" Command="{Binding QuickRangeCommand}" CommandParameter="month" Padding="8,4" Margin="0,0,4,0"/>
                                    <Button Content="{s:Tr 'Last month'}" Command="{Binding QuickRangeCommand}" CommandParameter="lastmonth" Padding="8,4"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Width="150" Margin="0,0,8,0" Visibility="{Binding ShowAsOf, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{s:Tr 'As at'}" Style="{StaticResource FieldLabel}"/><DatePicker SelectedDate="{Binding ToDate}"/>
                        </StackPanel>
                        <StackPanel Width="170" Margin="0,0,8,0" Visibility="{Binding ShowLocation, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{s:Tr 'Location'}" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding Locations}" SelectedItem="{Binding Location}" DisplayMemberPath="Name"/>
                        </StackPanel>
                        <StackPanel Width="170" Margin="0,0,8,0" Visibility="{Binding ShowUser, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{s:Tr 'User'}" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding Users}" SelectedItem="{Binding User}" DisplayMemberPath="Name"/>
                        </StackPanel>
                        <StackPanel Width="190" Margin="0,0,8,0" Visibility="{Binding ShowCategory, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{s:Tr 'Category'}" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" DisplayMemberPath="Name"/>
                        </StackPanel>
                        <StackPanel Width="210" Margin="0,0,8,0" Visibility="{Binding ShowSupplier, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{s:Tr 'Supplier'}" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding Supplier}" DisplayMemberPath="Name" IsTextSearchEnabled="True"/>
                        </StackPanel>
                        <StackPanel Width="210" Margin="0,0,8,0" Visibility="{Binding ShowCustomer, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{s:Tr 'Customer'}" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding Customer}" DisplayMemberPath="Name" IsTextSearchEnabled="True"/>
                        </StackPanel>
                        <StackPanel Width="210" Margin="0,0,8,0" Visibility="{Binding ShowEmployee, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{s:Tr 'Employee'}" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding Employees}" SelectedItem="{Binding Employee}" DisplayMemberPath="Name" IsTextSearchEnabled="True"/>
                        </StackPanel>
                        <StackPanel Width="160" Margin="0,0,8,0" Visibility="{Binding ShowItem, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{s:Tr 'Item code (empty = all)'}" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding ItemCode, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Width="110" Margin="0,0,8,0" Visibility="{Binding ShowDays, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{s:Tr 'Within days'}" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Days, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Width="90" Margin="0,0,8,0" Visibility="{Binding ShowTopN, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{s:Tr 'Top'}" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding TopN, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <Button Content="{s:Tr 'Run report'}" Command="{Binding RunCommand}" Style="{StaticResource BtnPrimary}" VerticalAlignment="Bottom" MinWidth="120" Margin="0,8,8,0"/>
                        <Button Content="{s:Tr 'Print'}" Command="{Binding PrintCommand}" VerticalAlignment="Bottom" Margin="0,8,8,0"/>
                        <Button Content="{s:Tr 'Excel'}" Command="{Binding ExportCommand}" VerticalAlignment="Bottom" Margin="0,8,0,0"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <TextBlock DockPanel.Dock="Top" Text="{Binding ResultInfo, Converter={StaticResource Tr}}" Style="{StaticResource Hint}" Margin="2,10,0,6"/>
            <DataGrid ItemsSource="{Binding Result}" s:GridAuto.Enabled="True" EnableRowVirtualization="True" RowHeight="30" FontSize="13"/>
        </DockPanel>
    </Grid>
</UserControl>
