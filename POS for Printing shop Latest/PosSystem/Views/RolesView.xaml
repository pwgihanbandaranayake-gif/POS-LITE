<UserControl x:Class="PosSystem.Views.RolesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:PosSystem.Helpers">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <DockPanel>
            <Button DockPanel.Dock="Bottom" Content="{s:Tr 'New role'}" Command="{Binding NewCommand}" Margin="0,10,0,0"/>
            <ListBox ItemsSource="{Binding Roles}" SelectedItem="{Binding Selected}" DisplayMemberPath="UserGroupName" FontSize="15"/>
        </DockPanel>
        <Border Grid.Column="2" Style="{StaticResource Panel}">
            <DockPanel>
                <Grid DockPanel.Dock="Top">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{s:Tr 'Role name'}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding RoleName, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{s:Tr 'Max discount % (0 = no limit)'}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding MaxDiscount, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>
                <CheckBox DockPanel.Dock="Top" Content="{s:Tr 'Administrator (has every permission)'}" IsChecked="{Binding IsSuperUser}" Margin="0,10,0,6"/>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="{s:Tr 'Save role and permissions'}" Command="{Binding SaveCommand}" Style="{StaticResource BtnPrimary}"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" IsEnabled="{Binding IsSuperUser, Converter={StaticResource InvBool}}">
                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="330" Margin="0,0,14,14" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="5" Padding="12,8">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="{s:Tr 'All / none'}" Style="{StaticResource BtnGhost}" Padding="4,2" MinHeight="26" FontSize="12"
                                                    Command="{Binding DataContext.ToggleGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                            <TextBlock Text="{Binding Name, Converter={StaticResource Tr}}" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsChecked}" Margin="0,3" ToolTip="{Binding Key}">
                                                        <TextBlock Text="{Binding Text, Converter={StaticResource Tr}}" TextWrapping="Wrap"/>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
