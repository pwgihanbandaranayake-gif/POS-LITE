<UserControl x:Class="PosSystem.Views.StockDocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:PosSystem.Helpers">
    <UserControl.Resources>
        <s:BindingProxy x:Key="Proxy" Data="{Binding}"/>
    </UserControl.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{Binding Heading, Converter={StaticResource Tr}}" Style="{StaticResource SectionTitle}" Margin="0"/>
            <TextBlock Text="{Binding HelpText, Converter={StaticResource Tr}}" Style="{StaticResource Hint}" Margin="0,2,0,10"/>
        </StackPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource Panel}" Padding="14,6,14,12">
            <WrapPanel>
                <StackPanel Width="160" Margin="0,0,12,0">
                    <TextBlock Text="{s:Tr 'Date'}" Style="{StaticResource FieldLabel}"/>
                    <DatePicker SelectedDate="{Binding DocDate}"/>
                </StackPanel>
                <StackPanel Width="280" Margin="0,0,12,0" Visibility="{Binding NeedsSupplier, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{s:Tr 'Supplier *'}" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding Supplier}" DisplayMemberPath="Name" IsTextSearchEnabled="True"/>
                </StackPanel>
                <StackPanel Width="180" Margin="0,0,12,0" Visibility="{Binding IsGrn, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{s:Tr 'Supplier invoice no'}" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding SupplierInvoiceNo}"/>
                </StackPanel>
                <StackPanel Width="180" Margin="0,0,12,0" Visibility="{Binding IsTransfer, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{s:Tr 'From'}" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding FromLocation, Mode=OneWay}" IsReadOnly="True"/>
                </StackPanel>
                <StackPanel Width="220" Margin="0,0,12,0" Visibility="{Binding IsTransfer, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{s:Tr 'To location *'}" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding ToLocations}" SelectedItem="{Binding ToLocation}" DisplayMemberPath="LocationName"/>
                </StackPanel>
                <StackPanel Width="320">
                    <TextBlock Text="{s:Tr 'Remarks / reason'}" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Remarks}"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Visibility="{Binding IsGrn, Converter={StaticResource BoolToVis}}">
                <CheckBox Content="{s:Tr 'Update item cost and selling price from this GRN'}" IsChecked="{Binding UpdateItemPrices}"/>
                <StackPanel Orientation="Horizontal">
                    <StackPanel Width="150" Margin="0,0,12,0">
                        <TextBlock Text="{s:Tr 'Discount received'}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Discount, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Width="150">
                        <TextBlock Text="{s:Tr 'Paid now (cash)'}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding PaidAmount, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <TextBlock VerticalAlignment="Center" Margin="0,0,20,0" FontFamily="{StaticResource DisplayFont}" FontSize="22">
                    <Run Text="{s:Tr 'Total'}"/> <Run Text="{Binding NetTotal, StringFormat={}{0:N2}, Mode=OneWay}" FontWeight="SemiBold"/>
                </TextBlock>
                <Button Content="{s:Tr 'Save'}" Command="{Binding SaveCommand}" Style="{StaticResource BtnPrimary}" MinWidth="150" MinHeight="46"/>
            </StackPanel>
        </Grid>

        <DockPanel Margin="0,12,0,0">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="{s:Tr 'Remove line'}" Command="{Binding RemoveLineCommand}" Style="{StaticResource BtnGhost}" Foreground="{StaticResource AlertBrush}"/>
                <Button DockPanel.Dock="Right" Content="{s:Tr 'Add'}" Command="{Binding AddItemCommand}" Margin="8,0,8,0"/>
                <TextBox Text="{Binding EntryCode, UpdateSourceTrigger=PropertyChanged}" FontSize="16" ToolTip="{s:Tr 'Scan / type item code and press Enter (empty Enter = search)'}">
                    <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding AddItemCommand}"/></TextBox.InputBindings>
                </TextBox>
            </DockPanel>
            <DataGrid ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}" IsReadOnly="False" RowHeight="38">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{s:Tr 'Code'}" Binding="{Binding Code}" Width="110" IsReadOnly="True"/>
                    <DataGridTextColumn Header="{s:Tr 'Item'}" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="{s:Tr 'In stock'}" Binding="{Binding InStock, StringFormat={}{0:0.###}}" Width="80" IsReadOnly="True" ElementStyle="{StaticResource RightCell}"/>
                    <DataGridTextColumn Header="{s:Tr 'Qty'}" Binding="{Binding Qty, UpdateSourceTrigger=PropertyChanged}" Width="90" FontWeight="Bold"/>
                    <DataGridTextColumn Header="{s:Tr 'Cost'}" Binding="{Binding Cost, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                    <DataGridTextColumn Header="{s:Tr 'Selling'}" Binding="{Binding Selling, UpdateSourceTrigger=PropertyChanged}" Width="100"
                                        Visibility="{Binding Data.IsGrn, Source={StaticResource Proxy}, Converter={StaticResource BoolToVis}}"/>
                    <DataGridTextColumn Header="{s:Tr 'Batch no'}" Binding="{Binding BatchNo}" Width="110"
                                        Visibility="{Binding Data.IsGrn, Source={StaticResource Proxy}, Converter={StaticResource BoolToVis}}"/>
                    <DataGridTemplateColumn Header="{s:Tr 'Expiry'}" Width="150"
                                            Visibility="{Binding Data.IsGrn, Source={StaticResource Proxy}, Converter={StaticResource BoolToVis}}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate><DatePicker SelectedDate="{Binding ExpDate, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0"/></DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{s:Tr 'Amount'}" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="110" IsReadOnly="True" ElementStyle="{StaticResource RightCell}"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </DockPanel>
</UserControl>
