<UserControl x:Class="PosSystem.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:PosSystem.Helpers">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="420"/>
        </Grid.ColumnDefinitions>
        <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding Selected}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{s:Tr 'User name'}" Binding="{Binding userId}" Width="150"/>
                <DataGridTextColumn Header="{s:Tr 'Full name'}" Binding="{Binding FullName}" Width="*"/>
                <DataGridTextColumn Header="{s:Tr 'Role'}" Binding="{Binding UserGroupName}" Width="160"/>
                <DataGridCheckBoxColumn Header="{s:Tr 'Active'}" Binding="{Binding IsSystemAccessible}" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>
        <Border Grid.Column="2" Style="{StaticResource Panel}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="{s:Tr 'User'}" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{s:Tr 'User name (for login)'}" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding LoginName, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="{s:Tr 'Full name (printed on bills)'}" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="{s:Tr 'Role'}" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding Role}" DisplayMemberPath="Name"/>
                <TextBlock Text="{s:Tr 'Default location'}" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding Locations}" SelectedItem="{Binding DefaultLocation}" DisplayMemberPath="LocationName"/>
                <TextBlock Text="{s:Tr 'Password (leave empty to keep the current one)'}" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}"/>
                <CheckBox Content="{s:Tr 'Can log in'}" IsChecked="{Binding IsActive}" Margin="0,12,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Content="{s:Tr 'New user'}" Command="{Binding NewCommand}" Margin="0,0,8,0"/>
                    <Button Content="{s:Tr 'Save user'}" Command="{Binding SaveCommand}" Style="{StaticResource BtnPrimary}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
