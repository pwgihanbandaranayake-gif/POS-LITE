<Application x:Class="PosSystem.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PosSystem.ViewModels"
             xmlns:v="clr-namespace:PosSystem.Views"
             xmlns:d="clr-namespace:PosSystem.Views.Dialogs"
             xmlns:c="clr-namespace:PosSystem.Helpers"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <c:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <c:BoolToVisibilityConverter x:Key="BoolToVisInv" Invert="True"/>
            <c:NullToVisibilityConverter x:Key="NullToVis"/>
            <c:NullToVisibilityConverter x:Key="NullToVisInv" Invert="True"/>
            <c:NonZeroToVisibilityConverter x:Key="NonZeroToVis"/>
            <c:InverseBoolConverter x:Key="InvBool"/>
            <c:HexToBrushConverter x:Key="HexBrush"/>
            <c:EqualsToBoolConverter x:Key="EqBool"/>
            <c:TrConverter x:Key="Tr"/>

            <!-- pages -->
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><v:DashboardView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:MasterListViewModel}"><v:MasterListView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ItemMasterViewModel}"><v:ItemMasterView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:UsersViewModel}"><v:UsersView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:RolesViewModel}"><v:RolesView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SalesReturnViewModel}"><v:SalesReturnView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:StockDocumentViewModel}"><v:StockDocumentView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:CashEntryViewModel}"><v:CashEntryView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SupplierPaymentViewModel}"><v:SupplierPaymentView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SessionCloseViewModel}"><v:SessionCloseView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:InvoicesViewModel}"><v:InvoicesView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ReportsViewModel}"><v:ReportsView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:BarcodePrintViewModel}"><v:BarcodePrintView/></DataTemplate>

            <!-- dialogs -->
            <DataTemplate DataType="{x:Type vm:MessageDialogViewModel}"><d:MessageDialogView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:TextInputViewModel}"><d:TextInputView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ManagerOverrideViewModel}"><d:ManagerOverrideView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:TerminalSetupViewModel}"><d:TerminalSetupView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:OpenSessionViewModel}"><d:OpenSessionView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ChangePasswordViewModel}"><d:ChangePasswordView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ItemSearchViewModel}"><d:ItemSearchView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:PricePickerViewModel}"><d:PricePickerView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:DiscountViewModel}"><d:DiscountView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:PaymentViewModel}"><d:PaymentView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:HeldBillsViewModel}"><d:HeldBillsView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:CustomerPickerViewModel}"><d:CustomerPickerView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:PickListViewModel}"><d:PickListView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ShortcutHelpViewModel}"><d:ShortcutHelpView/></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
