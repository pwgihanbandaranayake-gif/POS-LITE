<UserControl x:Class="PosSystem.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:PosSystem.Helpers">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="{Binding Greeting, Converter={StaticResource Tr}}" FontFamily="{StaticResource DisplayFont}" FontSize="20" Foreground="{StaticResource MutedBrush}"/>

            <Border Style="{StaticResource Panel}" Margin="0,14,0,0" Padding="20"
                    Visibility="{Binding CanSeeSales, Converter={StaticResource BoolToVisInv}}">
                <TextBlock Text="{s:Tr 'Press Start billing on the left to open the till. Your manager can give you access to reports.'}" TextWrapping="Wrap" FontSize="15"/>
            </Border>

            <Grid Margin="0,14,0,0" Visibility="{Binding CanSeeSales, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="420"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <Border Style="{StaticResource Panel}" Padding="24,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{s:Tr 'Sales today at this location'}" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="{Binding TodaySales, StringFormat={}{0:N2}}" FontFamily="{StaticResource DisplayFont}" FontSize="52"
                                           FontWeight="SemiBold" Foreground="{StaticResource LeafBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" TextBlock.FontSize="15">
                                <TextBlock><Run Text="{Binding TodayBills, Mode=OneWay}" FontWeight="Bold"/> <Run Text="{s:Tr 'bills'}"/></TextBlock>
                                <TextBlock><Run Text="{s:Tr 'Average bill'}"/> <Run Text="{Binding AvgBill, StringFormat={}{0:N2}, Mode=OneWay}" FontWeight="Bold"/></TextBlock>
                                <TextBlock><Run Text="{s:Tr 'Discounts'}"/> <Run Text="{Binding TodayDiscount, StringFormat={}{0:N2}, Mode=OneWay}" FontWeight="Bold"/></TextBlock>
                                <Border Background="{StaticResource TagBrush}" CornerRadius="3" Padding="8,2" Margin="0,6,0,0" HorizontalAlignment="Left"
                                        Visibility="{Binding LowStockCount, Converter={StaticResource NonZeroToVis}}">
                                    <TextBlock><Run Text="{Binding LowStockCount, Mode=OneWay}"/> <Run Text="{s:Tr 'items at re-order level'}"/></TextBlock>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Panel}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="{s:Tr 'Sales by hour'}" Style="{StaticResource SectionTitle}"/>
                            
                            <ItemsControl ItemsSource="{Binding Hourly}" Height="200">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Width="46" Margin="3,0" VerticalAlignment="Bottom">
                                            <TextBlock Text="{Binding ValueText}" FontSize="10" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                                            <Border Height="{Binding Height}" Background="{StaticResource LeafBrush}" CornerRadius="3,3,0,0" Margin="4,2,4,0"/>
                                            <TextBlock Text="{Binding Label, Converter={StaticResource Tr}}" HorizontalAlignment="Center" FontFamily="{StaticResource DisplayFont}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <Border Grid.Column="2" Style="{StaticResource Panel}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{s:Tr 'Top items today'}" Style="{StaticResource SectionTitle}"/>
                        <ItemsControl ItemsSource="{Binding TopItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,5">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Path='[Net Sales]', StringFormat={}{0:N2}}" FontWeight="SemiBold"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Path='[Qty Sold]', StringFormat={}{0:0.##}  x  }" Foreground="{StaticResource MutedBrush}" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Path='[Item]'}" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
