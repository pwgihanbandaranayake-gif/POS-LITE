<UserControl x:Class="PosSystem.Views.Dialogs.ChangePasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:PosSystem.Helpers" Width="400">
    <StackPanel>
        <TextBlock Text="{s:Tr 'Change my password'}" Style="{StaticResource SectionTitle}"/>
        <TextBlock Text="{s:Tr 'Current password'}" Style="{StaticResource FieldLabel}"/>
        <PasswordBox s:PasswordTarget.Property="Current" s:FocusOnLoad.Enabled="True"/>
        <TextBlock Text="{s:Tr 'New password'}" Style="{StaticResource FieldLabel}"/>
        <PasswordBox s:PasswordTarget.Property="New"/>
        <TextBlock Text="{s:Tr 'Repeat new password'}" Style="{StaticResource FieldLabel}"/>
        <PasswordBox s:PasswordTarget.Property="Confirm"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="{s:Tr 'Cancel'}" Command="{Binding CancelCommand}" MinWidth="100" Margin="0,0,8,0"/>
            <Button Content="{s:Tr 'Change password'}" Command="{Binding SaveCommand}" Style="{StaticResource BtnPrimary}" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</UserControl>
