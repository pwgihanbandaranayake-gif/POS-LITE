<UserControl x:Class="PosSystem.Views.Dialogs.DiscountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:PosSystem.Helpers" Width="470">
    <StackPanel>
        <TextBlock Text="{Binding Title, Converter={StaticResource Tr}}" Style="{StaticResource SectionTitle}"/>
        <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding BaseAmount, StringFormat={}{0:N2}}" FontFamily="{StaticResource DisplayFont}" FontSize="18"/>
            <TextBlock Text="{Binding Subject}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
        </DockPanel>
        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <RadioButton Content="{s:Tr 'Percentage %'}" IsChecked="{Binding IsPercent}" FontSize="15"/>
            <RadioButton Content="{s:Tr 'Amount'}" IsChecked="{Binding IsPercent, Converter={StaticResource InvBool}}" FontSize="15"/>
        </StackPanel>
        <TextBox Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource DisplayFont}" FontSize="28"
                 Margin="0,6,0,0" s:FocusOnLoad.Enabled="True">
            <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding ApplyCommand}"/></TextBox.InputBindings>
        </TextBox>
        <UniformGrid Columns="5" Margin="-3,8,-3,0">
            <Button Content="5%" Command="{Binding QuickCommand}" CommandParameter="5" Margin="3" Focusable="False"/>
            <Button Content="10%" Command="{Binding QuickCommand}" CommandParameter="10" Margin="3" Focusable="False"/>
            <Button Content="15%" Command="{Binding QuickCommand}" CommandParameter="15" Margin="3" Focusable="False"/>
            <Button Content="20%" Command="{Binding QuickCommand}" CommandParameter="20" Margin="3" Focusable="False"/>
            <Button Content="25%" Command="{Binding QuickCommand}" CommandParameter="25" Margin="3" Focusable="False"/>
        </UniformGrid>
        <Border Background="{StaticResource TagSoftBrush}" CornerRadius="4" Padding="12,10" Margin="0,12,0,0">
            <StackPanel>
                <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Discount, StringFormat=-{0:N2}}" FontWeight="SemiBold"/><TextBlock Text="{s:Tr 'Discount'}"/></DockPanel>
                <DockPanel Margin="0,4,0,0">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding After, StringFormat={}{0:N2}}" FontFamily="{StaticResource DisplayFont}" FontSize="20"/>
                    <TextBlock Text="{s:Tr 'After discount'}" VerticalAlignment="Center"/>
                </DockPanel>
            </StackPanel>
        </Border>
        <DockPanel Margin="0,18,0,0">
            <Button Content="{s:Tr 'Remove discount'}" Command="{Binding RemoveCommand}" Style="{StaticResource BtnGhost}" Foreground="{StaticResource AlertBrush}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{s:Tr 'Cancel'}" Command="{Binding CancelCommand}" MinWidth="100" Margin="0,0,8,0"/>
                <Button Content="{s:Tr 'Apply'}" Command="{Binding ApplyCommand}" Style="{StaticResource BtnPrimary}" MinWidth="110"/>
            </StackPanel>
        </DockPanel>
    </StackPanel>
</UserControl>
