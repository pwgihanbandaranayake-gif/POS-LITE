<UserControl x:Class="PosSystem.Views.Dialogs.HeldBillsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:PosSystem.Helpers" Width="820" Height="460">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{s:Tr 'Held bills'}" Style="{StaticResource SectionTitle}"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{s:Tr 'Delete'}" Command="{Binding DeleteCommand}" Style="{StaticResource BtnGhost}" Foreground="{StaticResource AlertBrush}" Margin="0,0,8,0"/>
            <Button Content="{s:Tr 'Close'}" Command="{Binding CancelCommand}" MinWidth="100" Margin="0,0,8,0"/>
            <Button Content="{s:Tr 'Recall'}" Command="{Binding RecallCommand}" Style="{StaticResource BtnPrimary}" MinWidth="120" IsDefault="True"/>
        </StackPanel>
        <DataGrid ItemsSource="{Binding Bills}" SelectedItem="{Binding Selected}" s:FocusOnLoad.Enabled="True" RowHeight="40">
            <DataGrid.InputBindings><KeyBinding Key="Enter" Command="{Binding RecallCommand}"/></DataGrid.InputBindings>
            <DataGrid.Columns>
                <DataGridTextColumn Header="{s:Tr 'Hold no'}" Binding="{Binding HoldNo}" Width="170"/>
                <DataGridTextColumn Header="{s:Tr 'Time'}" Binding="{Binding DateCreated, StringFormat={}{0:HH:mm}}" Width="70"/>
                <DataGridTextColumn Header="{s:Tr 'Note / customer'}" Binding="{Binding Note}" Width="*"/>
                <DataGridTextColumn Header="{s:Tr 'Lines'}" Binding="{Binding ItemCount}" Width="60"/>
                <DataGridTextColumn Header="{s:Tr 'Total'}" Binding="{Binding TotalAmount, StringFormat={}{0:N2}}" Width="110" ElementStyle="{StaticResource RightCell}"/>
                <DataGridTextColumn Header="{s:Tr 'By'}" Binding="{Binding CreatedByName}" Width="130"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
