<UserControl x:Class="PosSystem.Views.Dialogs.PickListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:PosSystem.Helpers" Width="420">
    <StackPanel>
        <TextBlock Text="{Binding Title, Converter={StaticResource Tr}}" Style="{StaticResource SectionTitle}"/>
        <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" MaxHeight="360" s:FocusOnLoad.Enabled="True" FontSize="16">
            <ListBox.InputBindings><KeyBinding Key="Enter" Command="{Binding ChooseCommand}"/></ListBox.InputBindings>
            <ListBox.ItemTemplate>
                <DataTemplate><TextBlock Text="{Binding Name}" Margin="6,8"/></DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{s:Tr 'Cancel'}" Command="{Binding CancelCommand}" MinWidth="100" Margin="0,0,8,0"/>
            <Button Content="{s:Tr 'Select'}" Command="{Binding ChooseCommand}" Style="{StaticResource BtnPrimary}" MinWidth="100"/>
        </StackPanel>
    </StackPanel>
</UserControl>
