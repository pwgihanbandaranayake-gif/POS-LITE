<UserControl x:Class="PosSystem.Views.Dialogs.ShortcutHelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:PosSystem.Helpers" Width="620">
    <StackPanel>
        <TextBlock Text="{s:Tr 'Billing keyboard shortcuts'}" Style="{StaticResource SectionTitle}"/>
        <ItemsControl ItemsSource="{Binding Keys}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="0,3">
                        <Border Background="{StaticResource ShelfBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="3"
                                Width="110" Padding="6,2" Margin="0,0,14,0">
                            <TextBlock Text="{Binding Key}" FontFamily="{StaticResource DisplayFont}" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding Action, Converter={StaticResource Tr}}" VerticalAlignment="Center"/>
                    </DockPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Content="{s:Tr 'Close'}" Command="{Binding CancelCommand}" HorizontalAlignment="Right" MinWidth="100" Margin="0,16,0,0" IsDefault="True" s:FocusOnLoad.Enabled="True"/>
    </StackPanel>
</UserControl>
