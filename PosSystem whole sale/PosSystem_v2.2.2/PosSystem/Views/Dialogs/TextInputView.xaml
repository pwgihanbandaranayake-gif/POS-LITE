<UserControl x:Class="PosSystem.Views.Dialogs.TextInputView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:PosSystem.Helpers" Width="440">
    <StackPanel>
        <TextBlock Text="{Binding Title, Converter={StaticResource Tr}}" Style="{StaticResource SectionTitle}"/>
        <TextBlock Text="{Binding Label, Converter={StaticResource Tr}}" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/>
        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" FontSize="20" s:FocusOnLoad.Enabled="True">
            <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding OkCommand}"/></TextBox.InputBindings>
        </TextBox>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="{s:Tr 'Cancel'}" Command="{Binding CancelCommand}" MinWidth="100" Margin="0,0,8,0"/>
            <Button Content="{s:Tr 'OK'}" Command="{Binding OkCommand}" Style="{StaticResource BtnPrimary}" MinWidth="100"/>
        </StackPanel>
    </StackPanel>
</UserControl>
