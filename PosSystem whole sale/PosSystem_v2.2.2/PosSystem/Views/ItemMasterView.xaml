<UserControl x:Class="PosSystem.Views.ItemMasterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:PosSystem.Helpers">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="560"/>
        </Grid.ColumnDefinitions>
        <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=300}" ToolTip="{s:Tr 'Search by name, code or barcode'}" Margin="0,0,10,0"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding FilterCategories}" SelectedItem="{Binding FilterCategory}" DisplayMemberPath="Name"/>
            </Grid>
            <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{s:Tr 'Code'}" Binding="{Binding ItemCode}" Width="100"/>
                    <DataGridTextColumn Header="{s:Tr 'Barcode'}" Binding="{Binding BarCode}" Width="130"/>
                    <DataGridTextColumn Header="{s:Tr 'Item'}" Binding="{Binding DisplayName}" Width="*"/>
                    <DataGridTextColumn Header="{s:Tr 'Category'}" Binding="{Binding CategoryName}" Width="130"/>
                    <DataGridTextColumn Header="{s:Tr 'Price'}" Binding="{Binding SellingPrice, StringFormat={}{0:N2}}" Width="95" ElementStyle="{StaticResource RightCell}"/>
                    <DataGridTextColumn Header="{s:Tr 'Stock'}" Binding="{Binding StockOnHand, StringFormat={}{0:0.###}}" Width="80" ElementStyle="{StaticResource RightCell}"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <Border Grid.Column="2" Style="{StaticResource Panel}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding FormTitle, Converter={StaticResource Tr}}" Style="{StaticResource SectionTitle}"/>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="{s:Tr 'Delete'}" Command="{Binding DeleteCommand}" Style="{StaticResource BtnGhost}" Foreground="{StaticResource AlertBrush}" Margin="0,0,8,0"/>
                    <Button Content="{s:Tr 'New item'}" Command="{Binding NewCommand}" Margin="0,0,8,0"/>
                    <Button Content="{s:Tr 'Save item'}" Command="{Binding SaveCommand}" Style="{StaticResource BtnPrimary}" MinWidth="110"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{s:Tr 'Item code *'}" Style="{StaticResource FieldLabel}"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="{s:Tr 'Next no'}" Command="{Binding GenerateCodeCommand}" Margin="6,0,0,0" Padding="8,4"/>
                                    <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"/>
                                </DockPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{s:Tr 'Barcode'}" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}" ToolTip="{s:Tr 'Scan the product barcode here'}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{s:Tr 'Item name (printed on bill) *'}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="{s:Tr 'Description'}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="{s:Tr 'Category'}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" DisplayMemberPath="Name"/>
                            </StackPanel>
                            <StackPanel Margin="6,0,0,0">
                                <TextBlock Text="{s:Tr 'Brand'}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding Brands}" SelectedItem="{Binding Brand}" DisplayMemberPath="Name"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="{s:Tr 'Unit'}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding Unit}" DisplayMemberPath="Name"/>
                            </StackPanel>
                            <StackPanel Margin="6,0,0,0">
                                <TextBlock Text="{s:Tr 'Tax'}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding Taxes}" SelectedItem="{Binding Tax}" DisplayMemberPath="Name"/>
                            </StackPanel>
                        </UniformGrid>
                        <UniformGrid Columns="4">
                            <StackPanel Margin="0,0,6,0" Visibility="{Binding CanViewCost, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{s:Tr 'Cost price'}" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding CostPrice, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding CanChangePrice, Converter={StaticResource InvBool}}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="{s:Tr 'Selling price'}" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding SellingPrice, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold" IsReadOnly="{Binding CanChangePrice, Converter={StaticResource InvBool}}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="{s:Tr 'Wholesale price'}" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding OurPrice, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding CanChangePrice, Converter={StaticResource InvBool}}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{s:Tr 'Re-order level'}" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding ReorderLevel, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock Text="{Binding MarginText}" Style="{StaticResource Hint}" Margin="0,4,0,0" Visibility="{Binding CanViewCost, Converter={StaticResource BoolToVis}}"/>
                        <CheckBox Content="{s:Tr 'Apply a changed selling price to stock already on the shelf'}" IsChecked="{Binding ApplyPriceToStock}"/>

                        <WrapPanel Margin="0,6,0,0">
                            <CheckBox Content="{s:Tr 'Allow discount'}" IsChecked="{Binding AllowDiscount}" Margin="0,4,18,4"/>
                            <CheckBox Content="{s:Tr 'Cashier can change price'}" IsChecked="{Binding AllowPriceChange}" Margin="0,4,18,4"/>
                            <CheckBox Content="{s:Tr 'Sold by weight (ask qty)'}" IsChecked="{Binding IsWeighted}" Margin="0,4,18,4"/>
                            <CheckBox Content="{s:Tr 'Service (no stock)'}" IsChecked="{Binding IsService}" Margin="0,4,18,4"/>
                            <CheckBox Content="{s:Tr 'Favourite on touch screen'}" IsChecked="{Binding ShowInTouch}" Margin="0,4,18,4"/>
                        </WrapPanel>
                        <TextBlock Text="{s:Tr 'Touch tile colour (e.g. #1F6B4A)'}" Style="{StaticResource FieldLabel}"/>
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Width="36" Margin="8,0,0,0" CornerRadius="4" Background="{Binding TouchColor, Converter={StaticResource HexBrush}}"/>
                            <TextBox Text="{Binding TouchColor, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>

                        <TextBlock Style="{StaticResource SectionTitle}" Margin="0,18,0,6">
                            <Run Text="{s:Tr 'Stock batches at this location'}"/>  <Run Text="{Binding StockOnHand, StringFormat={}({0:0.###}), Mode=OneWay}" Foreground="{StaticResource LeafBrush}"/>
                        </TextBlock>
                        <DataGrid ItemsSource="{Binding Batches}" MaxHeight="190" RowHeight="30">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{s:Tr 'Batch'}" Binding="{Binding BatchNo}" Width="*"/>
                                <DataGridTextColumn Header="{s:Tr 'Expiry'}" Binding="{Binding ExpDate, StringFormat={}{0:yyyy-MM-dd}}" Width="100"/>
                                <DataGridTextColumn Header="{s:Tr 'Qty'}" Binding="{Binding CurrentQuantity, StringFormat={}{0:0.###}}" Width="80" ElementStyle="{StaticResource RightCell}"/>
                                <DataGridTextColumn Header="{s:Tr 'Cost'}" Binding="{Binding CostPrice, StringFormat={}{0:N2}}" Width="90" ElementStyle="{StaticResource RightCell}"/>
                                <DataGridTextColumn Header="{s:Tr 'Price'}" Binding="{Binding SellingPrice, StringFormat={}{0:N2}}" Width="90" ElementStyle="{StaticResource RightCell}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="{s:Tr 'Stock is added through Goods received (GRN) or Stock adjustment, never typed here.'}"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
