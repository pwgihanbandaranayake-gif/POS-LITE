<UserControl x:Class="PosSystem.Views.Pos.PosHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:PosSystem.Helpers">
    <Border Background="{StaticResource LeafDarkBrush}" Padding="18,8">
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource BtnGhost}" Foreground="White" Command="{Binding RecallCommand}" ToolTip="{s:Tr 'Held bills (F7)'}" Focusable="False">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE823;" Style="{StaticResource Icon}" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding HeldCount, StringFormat={}{0} held}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource BtnGhost}" Foreground="White" Command="{Binding ToggleModeCommand}" ToolTip="{s:Tr 'Switch keyboard / touch (F11)'}" Focusable="False">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE765;" Style="{StaticResource Icon}" Margin="0,0,6,0"/>
                        <TextBlock Text="{s:Tr 'Touch / keyboard'}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource BtnGhost}" Foreground="White" Command="{Binding HelpCommand}" ToolTip="{s:Tr 'Shortcuts (F1)'}" Focusable="False">
                    <TextBlock Text="&#xE897;" Style="{StaticResource Icon}"/>
                </Button>
                <Button Style="{StaticResource BtnGhost}" Foreground="White" Command="{Binding ExitCommand}" ToolTip="{s:Tr 'Close billing (Esc)'}" Focusable="False">
                    <TextBlock Text="&#xE8BB;" Style="{StaticResource Icon}"/>
                </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding ShopName}" FontFamily="{StaticResource DisplayFont}" FontSize="19" FontWeight="SemiBold" Foreground="White"/>
                <Border Background="#2A7F5A" CornerRadius="3" Padding="8,2" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LocationName}" Foreground="White" FontSize="13"/>
                </Border>
                <TextBlock Foreground="#CFE6D8" FontSize="13.5" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Run Text="{Binding Cashier, Mode=OneWay}"/>   <Run Text="{Binding TerminalName, Mode=OneWay}"/>   <Run Text="{Binding Now, StringFormat={}{0:dd MMM yyyy  HH:mm:ss}, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
