<UserControl x:Class="PosSystem.Views.SupplierPaymentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:PosSystem.Helpers">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="400"/></Grid.ColumnDefinitions>
        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="{s:Tr 'Supplier'}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding Supplier}" DisplayMemberPath="Name" IsTextSearchEnabled="True"/>
                <TextBlock Margin="0,10,0,8" FontSize="15">
                    <Run Text="{s:Tr 'Total outstanding'}"/> <Run Text="{Binding TotalOutstanding, StringFormat={}{0:N2}, Mode=OneWay}" FontWeight="Bold"/>
                </TextBlock>
            </StackPanel>
            <DataGrid ItemsSource="{Binding Grns}" SelectedItem="{Binding Grn}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{s:Tr 'GRN'}" Binding="{Binding RefNo}" Width="180"/>
                    <DataGridTextColumn Header="{s:Tr 'Supplier inv'}" Binding="{Binding InvoiceNo}" Width="*"/>
                    <DataGridTextColumn Header="{s:Tr 'Date'}" Binding="{Binding TransactionDate, StringFormat={}{0:yyyy-MM-dd}}" Width="100"/>
                    <DataGridTextColumn Header="{s:Tr 'Net'}" Binding="{Binding NetTotal, StringFormat={}{0:N2}}" Width="110" ElementStyle="{StaticResource RightCell}"/>
                    <DataGridTextColumn Header="{s:Tr 'Paid'}" Binding="{Binding PaidAmount, StringFormat={}{0:N2}}" Width="110" ElementStyle="{StaticResource RightCell}"/>
                    <DataGridTextColumn Header="{s:Tr 'Balance'}" Binding="{Binding BalanceAmount, StringFormat={}{0:N2}}" Width="110" ElementStyle="{StaticResource RightCell}"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
        <Border Grid.Column="2" Style="{StaticResource Panel}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="{s:Tr 'Pay selected GRN'}" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{s:Tr 'Amount'}" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource DisplayFont}" FontSize="24"/>
                <TextBlock Text="{s:Tr 'Pay by'}" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding PayTypes}" SelectedItem="{Binding PayType}"/>
                <TextBlock Text="{s:Tr 'Cheque no'}" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding ChequeNo}"/>
                <TextBlock Text="{s:Tr 'Cheque date'}" Style="{StaticResource FieldLabel}"/>
                <DatePicker SelectedDate="{Binding ChequeDate}"/>
                <TextBlock Text="{s:Tr 'Remarks'}" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Remarks}"/>
                <Button Content="{s:Tr 'Save payment'}" Command="{Binding SaveCommand}" Style="{StaticResource BtnPrimary}" Margin="0,16,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
